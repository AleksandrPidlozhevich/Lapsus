<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lapsus.Views.CaretIndicatorWindow"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        CanResize="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight">

    <Border Background="{DynamicResource LapsusCardBrush}"
            BorderBrush="{DynamicResource LapsusBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="5,1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <!-- Dictation: a microphone, red while listening (its opacity follows the voice), grey while working. -->
            <Canvas x:Name="Mic" Width="12" Height="14" VerticalAlignment="Center" IsVisible="False">
                <Path x:Name="MicHead" Fill="#E5484D"
                      Data="M4,2.5 A2,2 0 0 1 8,2.5 L8,7 A2,2 0 0 1 4,7 Z" />
                <Path x:Name="MicStand" Stroke="#E5484D" StrokeThickness="1.3" StrokeLineCap="Round"
                      Data="M2,6.5 A4,4 0 0 0 10,6.5 M6,10.7 L6,13 M3.8,13 L8.2,13" />
            </Canvas>
            <TextBlock x:Name="Label"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="EN" />
        </StackPanel>
    </Border>
</Window>
