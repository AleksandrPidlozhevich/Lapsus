<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lapsus.ViewModels"
             x:Class="Lapsus.Views.PermissionsPanel"
             x:DataType="vm:PermissionsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.status">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource LapsusNoticeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LapsusAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.status.granted">
            <Setter Property="Background" Value="#2030A46C" />
            <Setter Property="BorderBrush" Value="#30A46C" />
        </Style>
        <Style Selector="Border.status > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.allow">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource LapsusNoticeInkBrush}" />
        </Style>
        <Style Selector="Button.allow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LapsusAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LapsusAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PermissionItem">
                <Border IsVisible="{Binding IsWanted}" Padding="12,10" CornerRadius="8"
                        Background="{DynamicResource LapsusCardBrush}"
                        BorderBrush="{DynamicResource LapsusBorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Why}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="status" Classes.granted="{Binding IsGranted}">
                            <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <Button Grid.Column="2" Classes="allow" VerticalAlignment="Center"
                                Content="{Binding ActionText}" Command="{Binding AllowCommand}"
                                IsVisible="{Binding !IsGranted}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
