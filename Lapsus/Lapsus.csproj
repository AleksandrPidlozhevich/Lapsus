<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!--
      The .ico is a compile input on Windows (it is embedded in Lapsus.exe by the resource step), so
      unlike the macOS .icns — which only the packaging script needs and generates on the fly — it is
      committed. Generated from Assets/icon-light.svg; see scripts/package-windows.ps1 for how.
    -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <CFBundleIdentifier>com.lapsus.app</CFBundleIdentifier>
        <CFBundleName>Lapsus</CFBundleName>
        <CFBundleDisplayName>Lapsus</CFBundleDisplayName>
        <LSUIElement>true</LSUIElement>
        <NSAccessibilityUsageDescription>Lapsus needs Accessibility access to capture keystrokes, find the text cursor, and inject corrected text in other apps.</NSAccessibilityUsageDescription>
        <NSInputMonitoringUsageDescription>Lapsus needs Input Monitoring to receive keystrokes system-wide via CGEventTap.</NSInputMonitoringUsageDescription>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
        <PackageReference Include="Velopack" Version="1.2.161" />
    </ItemGroup>

    <!-- The ONNX Runtime GenAI package, and which one each OS takes, lives in Lapsus.Neural. -->
    <ItemGroup>
        <ProjectReference Include="..\Lapsus.Core\Lapsus.Core.csproj" />
        <ProjectReference Include="..\Lapsus.Neural\Lapsus.Neural.csproj" />
    </ItemGroup>

    <!--
      The input backends and their machinery are internal on purpose — nothing outside this assembly
      has any business calling them — but the parts that are pure decision-making (what a hotkey press
      means, when the typing buffer is stale, what a rejected correction leaves behind) are worth
      pinning down, and they do not need an OS to run.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="Lapsus.Tests" />
    </ItemGroup>
</Project>
