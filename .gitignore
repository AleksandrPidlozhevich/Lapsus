.history/
*.vsix

# ============================================================
#  Node / Angular  (фронт, например NikaMotion)
# ============================================================
node_modules/
/wwwroot/node_modules
.sass-cache/
npm-debug.log*
yarn-error.log*
.angular/
dist/

# ----- Python (PTVS) ----------------------------------------
