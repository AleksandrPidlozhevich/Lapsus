<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Voice dictation probe and evaluation. "run" tries raw Whisper.net settings (stage 1); "eval" runs the
      pipeline the app runs — Lapsus.Speech's recognizer, the hallucination filter, the term restorer — and
      scores each layer against reference text. Left out of Lapsus.slnx: it needs a downloaded model and
      recordings, so nothing in CI can run it.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Lapsus.Speech\Lapsus.Speech.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <PackageReference Include="NAudio.WinMM" Version="2.2.1"/>
    </ItemGroup>
</Project>
