<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Lapsus.Lexicons</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Lapsus.Core\Lapsus.Core.csproj"/>
    </ItemGroup>

    <!-- The app's catalog itself, so the test fixtures come from the same pinned URLs the app downloads. -->
    <ItemGroup>
        <Compile Include="..\..\Lapsus\Settings\DictionaryCatalog.cs" Link="DictionaryCatalog.cs"/>
    </ItemGroup>

</Project>
