<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Whisper.net wraps whisper.cpp. Windows takes the Vulkan build next to the CPU one: any Vulkan GPU (NVIDIA,
      AMD, Intel) and, with the GPU off, the same CPU path the plain build has (stage 1: no slower). Other OSes
      take the base runtime, which carries Metal on macOS.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Whisper.net" Version="1.9.1"/>
        <PackageReference Include="Whisper.net.Runtime" Version="1.9.1"/>
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lapsus.Core\Lapsus.Core.csproj"/>
        <!-- Parakeet runs on the ONNX Runtime GenAI brings in there: one onnxruntime.dll per app. -->
        <ProjectReference Include="..\Lapsus.Neural\Lapsus.Neural.csproj"/>
    </ItemGroup>

    <!-- The 80-band mel preprocessor of NVIDIA's FastConformer CTC models, from onnx-asr 0.12.0 (MIT, Ilya Stupakov). -->
    <ItemGroup>
        <None Include="Data\nemo80.onnx" Link="nemo80.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lapsus.Tests"/>
    </ItemGroup>
</Project>
